<?xml version='1.0' encoding='utf-8'?>
<screensaver name="linuxdrift" _label="LinuxDrift — Drift / Deriva">
  <command arg="--root" />
  <select id="palette">
    <option id="saved" _label="Palette salvata con linuxdrift --config" />
    <option id="original" _label="Original" arg-set="--palette original" />
    <option id="plasma" _label="Plasma" arg-set="--palette plasma" />
    <option id="poolside" _label="Poolside" arg-set="--palette poolside" />
    <option id="gumdrop" _label="Gumdrop" arg-set="--palette gumdrop" />
    <option id="silver" _label="Silver" arg-set="--palette silver" />
    <option id="charcoal" _label="Charcoal" arg-set="--palette charcoal" />
    <option id="glitter" _label="Glitter" arg-set="--palette glitter" />
    <option id="andromeda" _label="Andromeda" arg-set="--palette andromeda" />
    <option id="verdant" _label="Verdant" arg-set="--palette verdant" />
    <option id="freedom" _label="Freedom" arg-set="--palette freedom" />
  </select>
  <select id="performance">
    <option id="saved-performance" _label="Prestazioni salvate con linuxdrift --config" />
    <option id="perf-eco" _label="Eco — GPU minimo" arg-set="--preset eco" />
    <option id="perf-light" _label="Leggero — GPU molto basso" arg-set="--preset light" />
    <option id="perf-haswell" _label="Haswell fluido — GPU basso" arg-set="--preset haswell" />
    <option id="perf-light-plus" _label="Leggero Plus — GPU basso–medio" arg-set="--preset light-plus" />
    <option id="perf-balanced" _label="Bilanciato — GPU medio" arg-set="--preset balanced" />
    <option id="perf-balanced-plus" _label="Bilanciato Plus — GPU medio–alto" arg-set="--preset balanced-plus" />
    <option id="perf-detailed" _label="Dettagliato — GPU alto" arg-set="--preset detailed" />
    <option id="perf-original" _label="Originale Flux — GPU alto" arg-set="--preset original" />
    <option id="perf-high" _label="Alta qualità — GPU molto alto" arg-set="--preset high" />
    <option id="perf-ultra" _label="Ultra — GPU massimo" arg-set="--preset ultra" />
  </select>
  <select id="clock">
    <option id="saved-clock" _label="Orologio come da configurazione salvata" />
    <option id="clock-on" _label="Mostra orologio" arg-set="--clock" />
    <option id="clock-off" _label="Nascondi orologio" arg-set="--no-clock" />
  </select>
  <hgroup>
    <vgroup>
      <number id="lineLength" type="slider" arg="--set lineLength=%" _label="Lunghezza linee" low="1" high="1000" default="450" />
      <number id="lineWidth" type="slider" arg="--set lineWidth=%" _label="Larghezza linee" low="0.1" high="100" default="9" />
      <number id="lineBeginOffset" type="slider" arg="--set lineBeginOffset=%" _label="Inizio sfumatura" low="0" high="1" default="0.4" />
    </vgroup>
    <vgroup>
      <number id="lineVariance" type="slider" arg="--set lineVariance=%" _label="Varianza" low="0" high="1" default="0.5" />
      <number id="overallScale" type="slider" arg="--set overallScale=%" _label="Scala complessiva" low="0.1" high="10" default="1" />
      <number id="noiseMultiplier" type="slider" arg="--set noiseMultiplier=%" _label="Intensita rumore" low="0" high="10" default="0.45" />
    </vgroup>
  </hgroup>
  <_description>LinuxDrift: versione Linux ispirata al salvaschermo Drift / Deriva di macOS.
Basato su Flux di Sander Melnikov (sandydoo/flux), licenza MIT.
Non e un port ufficiale Apple. Funziona completamente offline.

Le opzioni qui selezionate sono salvate da XScreenSaver e hanno precedenza
sul file utente LinuxDrift. Per tutte le opzioni, i canali rumore e le immagini
personali, la posizione e la sfumatura dell’orologio, aprire "Impostazioni LinuxDrift" oppure eseguire linuxdrift --config.

Sorgente originale su GitHub: sandydoo/flux
Versione Linux su GitHub: spacecdr/LinuxDrift
</_description>
</screensaver>